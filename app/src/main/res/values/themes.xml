<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tutora" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- The splash stays until settings and migrations are ready (AC-001-4). -->
    <style name="Theme.Tutora.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Tutora</item>
    </style>
</resources>
